{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "excalidraw-rs",
  "version": "0.2.0",
  "identifier": "com.hutsonlabs.excalidraw-rs",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "excalidraw-rs",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 10, "y": 20 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "license": "PolyForm-Noncommercial-1.0.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.png"],
    "targets": ["app", "dmg"],
    "fileAssociations": [
      {
        "ext": ["excalidraw"],
        "name": "Excalidraw Drawing",
        "description": "An Excalidraw scene",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
